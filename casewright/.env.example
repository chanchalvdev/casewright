# ── LLM provider ──────────────────────────────────────────────────────────────
# LLM_PROVIDER picks the model backend: gemini | ollama | openai | none.
# none runs detection rules only: no API key, no AI classification or
# investigation; events no rule matches are stored as Unclassified (P5).
# Leave it empty to auto-detect: Gemini when GEMINI_API_KEY is set,
# otherwise the OpenAI-compatible endpoint below.
# LLM_PROVIDER=

# Gemini — get a key at https://aistudio.google.com/apikey
# On the free tier Google may use prompts to improve its products and human
# reviewers may read them: do not send real logs there, use Ollama instead.
GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# GEMINI_MODEL=gemini-3.8-flash

# Ollama — fully local, no key, logs never leave this machine.
# Set LLM_PROVIDER=ollama and pull the model first: ollama pull llama3.2
# OLLAMA_MODEL=llama3.2

# Any OpenAI-compatible endpoint (Kimchi, OpenAI, Groq, vLLM…)
# KIMCHI_API_KEY=your_api_key_here
# KIMCHI_BASE_URL=https://api.kimchi.ai/v1
# CASEWRIGHT_MODEL=kimi-k2-5

# Classifier prompt version (internal/classifier/prompts/classifier_<v>.txt).
# Leave unset to use the default the eval gate approved (DefaultPromptVersion);
# set it only to try another version, e.g. PROMPT_VERSION=v1.
# PROMPT_VERSION=

# ── Tracing (optional) ────────────────────────────────────────────────────────
# One OpenTelemetry span per LLM call: input, answer, label, confidence,
# tokens, latency, prompt version. Off when nothing below is set.
# Any OTLP/HTTP backend, e.g. a self-hosted Arize Phoenix (keeps logs on-host):
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:6006
# Or Langfuse (Cloud Hobby is free). Use it for eval runs, not real logs:
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com
# false = spans keep metadata only, never the log line or the model's answer.
# TRACE_LOG_CONTENT=true

# ── Server ────────────────────────────────────────────────────────────────────
CONDUCTOR_PORT=8080
ALLOWED_ORIGIN=http://localhost:5173

# Comma-separated API keys. When set, /api, /ws, /metrics and /classify
# require "Authorization: Bearer <key>" or "X-API-Key: <key>".
# Leave empty only for local development. For the dashboard, put the same key
# in web/.env.local as VITE_CASEWRIGHT_API_KEY=<key>.
# CASEWRIGHT_API_KEYS=

# ── Storage ───────────────────────────────────────────────────────────────────
# Event history. docker-compose publishes Postgres on 5433. If set but
# unreachable the server refuses to start; leave empty to keep events in
# memory only (lost on restart).
POSTGRES_DSN=postgres://casewright:casewright@localhost:5433/casewright?sslmode=disable

# Vector search (semantic "similar events")
QDRANT_ADDR=localhost:6334

# Embeddings for vector search, and chat when LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434

# ── Dashboard users ──────────────────────────────────────────────────────────
# Creates the first admin when no user exists yet (no-op afterwards; remove the
# password once you have logged in). Admins add more users in the dashboard.
# CASEWRIGHT_ADMIN_USER=admin
# CASEWRIGHT_ADMIN_PASSWORD=
# How long a login lasts (5m–720h):
# CASEWRIGHT_SESSION_TTL=12h
# Mark the session cookie Secure; set when serving behind HTTPS:
# CASEWRIGHT_COOKIE_SECURE=true

# ── Data retention (needs POSTGRES_DSN) ───────────────────────────────────────
# Days to keep each kind of data; unset or 0 keeps it forever. Purged hourly.
# Resolved incidents go with their alerts, history and response actions.
# RETENTION_EVENTS_DAYS=90
# RETENTION_INCIDENTS_DAYS=365
# RETENTION_AUDIT_DAYS=365

# ── Log ingestion ─────────────────────────────────────────────────────────────
# Receive syslog from rsyslog / syslog-ng / network devices. Ports below 1024
# (like 514) need root, so forward 514 to these if your senders need it.
# SYSLOG_UDP_ADDR=:5514
# SYSLOG_TCP_ADDR=:5514

# ── Detection rules ───────────────────────────────────────────────────────────
# rules-first: a Sigma rule match classifies the event with no LLM call (default)
# enrich:      always ask the LLM, attach matching rules
# off:         no rules. See docs/DETECTION.md.
# DETECTION_MODE=rules-first
# Extra Sigma rules (searched recursively), e.g. a SigmaHQ checkout:
# SIGMA_RULES_DIR=/opt/sigma/rules/linux

# ── Incidents ─────────────────────────────────────────────────────────────────
# Alerts sharing an IP, user or host within this window join one incident.
# INCIDENT_WINDOW=1h
# Least severe alert that opens or joins an incident (P4/P5 stay events only).
# INCIDENT_MIN_SEVERITY=P3

# ── Response playbooks ───────────────────────────────────────────────────────
# Playbooks propose actions; analysts approve them. See docs/RESPONSE.md.
# Extra playbooks (.yml), searched recursively:
# PLAYBOOKS_DIR=/etc/casewright/playbooks
# Receives approved block_ip / disable_user / isolate_host actions as JSON.
# Point it at your automation (n8n, Tines, Shuffle, AWX, a Lambda…):
# RESPONSE_WEBHOOK_URL=https://automation.example.com/hooks/casewright
# Slack incoming webhook for notify actions (contains a secret token):
# SLACK_WEBHOOK_URL=

# ── Threat intel (optional, used by the investigation agent) ─────────────────
# ABUSEIPDB_KEY=
# OTX_API_KEY=

# ── IOC watchlists ────────────────────────────────────────────────────────────
# Read-only lists of IPs, ranges, domains and hashes (*.txt, *.csv, *.list),
# loaded at start. Feeds and manual lists are managed in the dashboard.
# IOC_WATCHLIST_DIR=watchlists

# ── Demo data ─────────────────────────────────────────────────────────────────
# Replayed through the pipeline on start when no events are stored yet.
# SEED_LOG_FILE=demo/attack-scenario.log
