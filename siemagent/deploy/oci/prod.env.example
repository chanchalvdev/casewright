# Production settings for deploy/oci. On the VM: cp prod.env.example .env,
# fill it in, chmod 600 .env. Never commit the real file.

# ── Public address ────────────────────────────────────────────────────────────
# Your domain, or <public-ip-with-dashes>.sslip.io (e.g. 141-148-1-2.sslip.io).
DOMAIN=141-148-1-2.sslip.io
# Let's Encrypt sends certificate expiry warnings here.
ACME_EMAIL=you@example.com

# ── Images ────────────────────────────────────────────────────────────────────
# GitHub user or org that owns the GHCR images (lower case).
GHCR_OWNER=chanchalvdev

# ── Database ──────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=change-me

# ── LLM (production always uses the local Ollama model) ──────────────────────
OLLAMA_MODEL=llama3.2:3b
# Leave PROMPT_VERSION unset: production then runs the classifier's default
# prompt, which is the one the eval gate approved for this release.
# PROMPT_VERSION=
# Rules classify what they can; the LLM only sees events no rule matched.
DETECTION_MODE=rules-first

# ── Access ────────────────────────────────────────────────────────────────────
# First admin account; remove the password once you have logged in.
SIEM_ADMIN_USER=admin
SIEM_ADMIN_PASSWORD=change-me-too
# API key for scripts and the post-deploy smoke test (openssl rand -hex 32).
# Store the same value as the OCI_API_KEY GitHub secret.
SIEM_API_KEYS=change-me-api-key

# ── Tracing ───────────────────────────────────────────────────────────────────
# Live traces go to Phoenix on this VM (set in docker-compose.yml).
# false = spans keep metadata only, never the log line or the model's answer.
TRACE_LOG_CONTENT=true
